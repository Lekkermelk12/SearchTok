# Admin Bot Token (nichedevpostbot - for posting coins)
ADMIN_BOT_TOKEN=your_admin_bot_token_here

# Public Bot Token (nichedbot - for users to browse coins)
PUBLIC_BOT_TOKEN=your_public_bot_token_here

# Backward compatibility
TELEGRAM_BOT_TOKEN=your_admin_bot_token_here

# Admin User IDs (comma-separated list of Telegram user IDs who can post memecoins)
# To get your user ID, message @userinfobot on Telegram
ADMIN_USER_IDS=123456789,987654321

# Telegram Channel (optional - if you want to also post to a channel)
# Format: @channelname or -100xxxxxxxxxx
# Make sure to add your bot as an admin to the channel
TELEGRAM_CHANNEL=
